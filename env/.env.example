# Template for global environment secrets.
#
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.
# stow links this directory into ~, so these become ~/.env / ~/.env.example,
# and ~/.zshrc exports every variable defined in ~/.env.

# OpenAI-compatible model server shared host (see .pi/agent/models.json).
# Two providers share the same host but use separate ports and keys.
# Subagent provider and orchestrator provider.
PI_MODEL_HOST=
PI_SUBAGENT_PORT=
PI_SUBAGENT_API_KEY=
PI_ORCHESTRATOR_PORT=
PI_ORCHESTRATOR_API_KEY=
