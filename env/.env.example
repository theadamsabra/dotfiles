# Template for global environment secrets.
#
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.
# stow links this directory into ~, so these become ~/.env / ~/.env.example,
# and ~/.zshrc exports every variable defined in ~/.env.

# My local OpenAI-compatible model server (see .pi/agent/models.json).
# PI_MODEL_API_KEY is consumed by pi via ${PI_MODEL_API_KEY} in models.json.
# HOST/PORT are for your own scripts — pi needs a literal baseUrl in models.json.
PI_MODEL_HOST=
PI_MODEL_PORT=
PI_MODEL_API_KEY=
